# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://lubxtjxjuzsgkiewbycm.supabase.co
# Publishable key (sb_publishable_…, or the legacy anon key). Safe in the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…, or the legacy service_role key). SERVER ONLY — bypasses RLS.
# Used to grant XP/achievements and by the realtime server. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# OAuth buttons on the sign-in page (enable the same providers in Supabase → Authentication → Sign In / Providers)
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,github

# --- Realtime server (server/ws-server.cjs) ---
# URL of the realtime server, as seen by the browser
NEXT_PUBLIC_WS_URL=http://localhost:4001
# Shared secret for realtime tokens (set the same value on the web app and the realtime server).
# generate with: openssl rand -base64 32
REALTIME_JWT_SECRET=change-me
# Used by the realtime server itself
WS_PORT=4001
WS_CORS_ORIGIN=http://localhost:3000
