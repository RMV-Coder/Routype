# --- Database (MySQL 8) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=routype
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=routype_db

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# Optional OAuth providers (buttons only appear when both values are set)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Realtime server (server/ws-server.cjs) ---
# URL of the realtime server, as seen by the browser
NEXT_PUBLIC_WS_URL=http://localhost:4001
# Shared secret for realtime tokens (defaults to NEXTAUTH_SECRET)
REALTIME_JWT_SECRET=
# Used by the realtime server itself
WS_PORT=4001
WS_CORS_ORIGIN=http://localhost:3000
